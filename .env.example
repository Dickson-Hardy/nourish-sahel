# Public origin used by SEO and same-origin form validation.
NOURISH_SITE_URL=

# Hostinger Mail API token and the resource ID of the sending mailbox.
NOURISH_HOSTINGER_API_TOKEN=
NOURISH_HOSTINGER_MAILBOX_ID=

# Inbox receiving contact enquiries and newsletter signup requests.
NOURISH_FORM_TO=info@nourishsahel.com

# A persistent, writable local file shared by all Node processes serving the site.
NOURISH_FORM_LIMIT_DB=.data/form-limits.sqlite
